name: epfl:cheep:pgm_clock_divider:0.1.0
description: pgm_clock_divider

filesets:
  rtl:
    depend:
    - epfl:cheep:packages
    files:
    - rtl/pgm_clock_divider_reg_pkg.sv
    - rtl/pgm_clock_divider_reg_top.sv
    - rtl/pgm_clock_divider.sv
    file_type: systemVerilogSource

  verilator-waivers:
    files:
    - waivers/pgm_clock_divider-waivers.vlt
    file_type: vlt

targets:
  default: &default
    filesets:
    - rtl
    - tool_verilator ? (verilator-waivers)
