// File: pgm_clock_divider-waivers.sv
// Author:Juan Sapriza
// Description: Verilator waivers for pgm_clock_divider

`verilator_config
// Automatically generated control registers
lint_off -rule DECLFILENAME -file "*/pgm_clock_divider/rtl/pgm_clock_divider_reg_top.sv" -match "Filename 'pgm_clock_divider_reg_top' does not match MODULE name: 'pgm_clock_divider_reg_top_intf'"

lint_off -rule WIDTH -file "*/pgm_clock_divider/rtl/pgm_clock_divider_reg_top.sv" -match "Operator ASSIGNW expects * bits on the Assign RHS, but Assign RHS's SEL generates * bits."
lint_off -rule WIDTH -file "*/pgm_clock_divider/rtl/pgm_clock_divider_reg_top.sv" -match "Operator ASSIGNW expects 32 bits on the Assign RHS, but Assign RHS's VARREF 'reg_rdata' generates 8 bits."
lint_off -rule WIDTH -file "*/pgm_clock_divider/rtl/pgm_clock_divider_reg_top.sv" -match "Operator NOT expects 4 bits on the LHS, but LHS's VARREF 'reg_be' generates 1 bits."
