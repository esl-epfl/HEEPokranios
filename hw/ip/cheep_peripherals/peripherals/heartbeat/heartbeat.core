name: epfl:cheep:heartbeat:0.1.0
description: heartbeat

filesets:
  rtl:
    depend:
    - epfl:cheep:packages
    files:
    - rtl/heartbeat.sv
    file_type: systemVerilogSource

  verilator-waivers:
    files:
    file_type: vlt

targets:
  default: &default
    filesets:
    - rtl
    - tool_verilator ? (verilator-waivers)