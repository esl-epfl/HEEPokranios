name: epfl:cheep:BPE_ctrl:0.1.0
description: BPE_ctrl

filesets:
  rtl:
    depend:
    - epfl:cheep:packages
    files:
    - rtl/bpe_ctrl_reg_pkg.sv
    - rtl/bpe_ctrl_reg_top.sv
    - rtl/BPE_ctrl.sv
    file_type: systemVerilogSource

  verilator-waivers:
    files:
    - waivers/BPE_ctrl-waivers.vlt
    file_type: vlt

targets:
  default: &default
    filesets:
    - rtl
    - tool_verilator ? (verilator-waivers)