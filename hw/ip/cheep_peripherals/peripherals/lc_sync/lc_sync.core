name: epfl:cheep:lc_sync:0.1.0
description: lc_sync

filesets:
  rtl:
    depend:
    - epfl:cheep:packages
    - pulp-platform.org::common_cells
    files:
    - rtl/lc_sync.sv
    file_type: systemVerilogSource

  verilator-waivers:
    files:
    - waivers/lc_sync-waivers.vlt
    file_type: vlt

targets:
  default: &default
    filesets:
    - rtl
    - tool_verilator ? (verilator-waivers)