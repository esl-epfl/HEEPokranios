`verilator_config
// TB waivers
lint_off -rule WIDTH -file "*/ddr_edge_detector_tb.sv" -match "Operator ASSIGNDLY expects 1 bits on the Assign RHS, but Assign RHS's RAND generates 32 bits."
lint_off -rule UNUSED -file "*/ddr_edge_detector_tb.sv" -match "Signal is not used: '*_out'"
lint_off -rule UNUSED -file "*/ddr_edge_detector_tb.sv" -match "Signal is not used: '*_delayed_q'"

// Common cells waivers
lint_off -rule DECLFILENAME -file "*src/*.sv" -match "Filename '*' does not match IFACE name: '*'"
lint_off -rule DECLFILENAME -file "*src/*.sv" -match "Filename '*' does not match MODULE name: '*'"
lint_off -rule PINCONNECTEMPTY -file "*src/*.sv" -match "Instance pin connected by name with empty reference: '*'*"
// lint_off -rule GENUNNAMED -file "*src/*.sv" -match "Unnamed generate block '*' (IEEE 1800-2023 27.6)*"
lint_off -rule UNUSED -file "*src/cb_filter_pkg.sv" -match "Parameter is not used: 'EgSeeds'*"
