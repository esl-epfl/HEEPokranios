`verilator_config

// Automatically generated control registers
lint_off -rule DECLFILENAME -file "*/dlc/rtl/dlc_reg_top.sv" -match "Filename 'dlc_reg_top' does not match MODULE name: 'dlc_reg_top_intf'"
lint_off -rule UNUSED -file "*/dlc/rtl/dlc_reg_top.sv" -match "Parameter is not used: 'AW'"

lint_off -rule WIDTH -file "*/dlc/rtl/dlc_reg_top.sv" -match "Operator ASSIGNW expects * bits on the Assign RHS, but Assign RHS's SEL generates * bits."
lint_off -rule WIDTH -file "*/dlc/rtl/dlc_reg_top.sv" -match "Operator ASSIGNW expects 32 bits on the Assign RHS, but Assign RHS's VARREF 'reg_rdata' generates 8 bits."
lint_off -rule WIDTH -file "*/dlc/rtl/dlc_reg_top.sv" -match "Operator NOT expects 4 bits on the LHS, but LHS's VARREF 'reg_be' generates 1 bits."

lint_off -rule UNUSED -file "*/dlc/rtl/dlc.sv" -match "*tmp*"

lint_off -rule DECLFILENAME -file "*/dlc/rtl/dlc_reg_top.sv"
lint_off -rule WIDTH -file "*/dlc/rtl/dlc_reg_top.sv" -match "Operator ASSIGNW expects 6 bits on the Assign RHS, but Assign RHS's SEL generates 32 bits.*"
lint_off -rule UNUSED -file "*/dlc/rtl/dlc.sv" -match "Bits of signal are not used: 'dlc_output'[16]*"
lint_off -rule UNUSED -file "*/dlc/rtl/dlc.sv" -match "Bits of signal are not used: 'dt_ovf_cnt_output'[16]"
lint_off -rule UNUSED -file "*/dlc/rtl/dlc.sv" -match "Bits of signal are not used: 'hw_fifo_req_i'[32]*"
lint_off -rule UNUSED -file "*/dlc/rtl/dlc.sv" -match "Bits of signal are not used: 'reg2hw'[4]"
