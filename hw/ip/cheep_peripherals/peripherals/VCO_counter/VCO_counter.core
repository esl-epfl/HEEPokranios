name: epfl:cheep:VCO_counter:0.1.0
description: VCO_counter

filesets:
  rtl:
    depend:
    - epfl:cheep:packages
    files:
    - rtl/vco_counter_reg_pkg.sv
    - rtl/vco_counter_reg_top.sv
    - rtl/VCO_counter.sv
    file_type: systemVerilogSource

  verilator-waivers:
    files:
    - waivers/VCO_counter-waivers.vlt
    file_type: vlt

targets:
  default: &default
    filesets:
    - rtl
    - tool_verilator ? (verilator-waivers)