name: epfl:cheep:reg2ser:0.1.0
description: reg2ser

filesets:
  rtl:
    depend:
    - epfl:cheep:packages
    files:
    - rtl/reg2ser.sv
    file_type: systemVerilogSource

  verilator-waivers:
    files:
    - waivers/reg2ser-waivers.vlt
    file_type: vlt

targets:
  default: &default
    filesets:
    - rtl
    - tool_verilator ? (verilator-waivers)