name: epfl:cheep:wpdt2ser:0.1.0
description: WPDT2ser

filesets:
  rtl:
    depend:
    - epfl:cheep:packages
    files:
    - rtl/wpdt2ser_reg_pkg.sv
    - rtl/wpdt2ser_reg_top.sv
    - rtl/WPDT2ser.sv
    file_type: systemVerilogSource

  verilator-waivers:
    files:
    - waivers/WPDT2ser-waivers.vlt
    file_type: vlt

targets:
  default: &default
    filesets:
    - rtl
    - tool_verilator ? (verilator-waivers)