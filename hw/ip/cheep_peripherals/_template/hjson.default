{
    name: "${peripheral_name}"
    clock_primary: "clk_i"
    reset_primary: "rst_ni"
    bus_interfaces: [
        {
            protocol: "reg_iface"
            direction: "device"
        }
    ]
    regwidth: "32"
    registers: [
        { name:   "Example"
        desc:     "This is an example register"
        swaccess: "rw"
        hwaccess: "hrw"
        fields: [
            { bits: "0:0"
              name: "example"
              desc: "This is an example register"
               }
           ]
        }

        ]
}