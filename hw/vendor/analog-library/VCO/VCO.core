name: epfl:cheep:vco:0.1.0
description: VCO model

filesets:
    rtl:
        depend:
        - epfl:cheep:analog_defs
        files:
        - include/vco_pkg.sv
        - Verilog/VCO_wrapper.sv
        file_type: systemVerilogSource

    verilator-waivers:
        files:
        - waivers/VCO.vlt
        file_type: vlt

targets:
  default: &default
    filesets:
    - rtl
    - tool_verilator ? (verilator-waivers)

