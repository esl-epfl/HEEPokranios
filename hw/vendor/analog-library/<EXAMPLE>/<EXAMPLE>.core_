name: epfl:cheep:<example>:0.1.0
description: <EXAMPLE> model

filesets:
  rtl:
    depend:
    - epfl:cheep:analog_defs
    files:
    - Verilog/<EXAMPLE>_wrapper.sv
    file_type: systemVerilogSource

  verilator-waivers:
    files:
    - waivers/<EXAMPLE>.vlt
    file_type: vlt

targets:
  default: &default
    filesets:
    - rtl
    - tool_verilator ? (verilator-waivers)