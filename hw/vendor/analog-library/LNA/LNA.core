name: epfl:cheep:lna:0.1.0
description: LNA model

filesets:
  rtl:
    depend:
    - epfl:cheep:analog_defs
    files:
    - Verilog/LNA_wrapper.sv
    - include/lna_pkg.sv
    file_type: systemVerilogSource

  verilator-waivers:
    files:
    - waivers/LNA.vlt
    file_type: vlt

targets:
  default: &default
    filesets:
    - rtl
    - tool_verilator ? (verilator-waivers)

