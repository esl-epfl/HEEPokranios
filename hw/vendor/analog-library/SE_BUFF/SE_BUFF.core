name: epfl:cheep:se_buff:0.1.0
description: SE_BUFF model

filesets:
  rtl:
    depend:
    - epfl:cheep:analog_defs
    files:
    - Verilog/SE_BUFF_wrapper.sv
    file_type: systemVerilogSource

  verilator-waivers:
    files:
    - waivers/SE_BUFF.vlt
    file_type: vlt

targets:
  default: &default
    filesets:
    - rtl
    - tool_verilator ? (verilator-waivers)