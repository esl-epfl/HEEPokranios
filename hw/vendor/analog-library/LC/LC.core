name: epfl:cheep:lc:0.1.0
description: LC model

filesets:
  rtl:
    depend:
    - epfl:cheep:analog_defs
    files:
    - include/lc_pkg.sv
    - Verilog/LC_wrapper.sv
    - tb/data.txt: { file_type: user, copyto: lc_data.txt }  # Simply copy the file to the build folder
    file_type: systemVerilogSource

  verilator-waivers:
    files:
    - waivers/LC.vlt
    file_type: vlt

targets:
  default: &default
    filesets:
    - rtl
    - tool_verilator ? (verilator-waivers)

