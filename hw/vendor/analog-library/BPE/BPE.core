name: epfl:cheep:bpe:0.1.0
description: BPE analog model

filesets:
  rtl:
    depend:
    - epfl:cheep:analog_defs
    files:
    - Verilog/BPE_wrapper.sv
    - package/bpe_pkg.sv
    file_type: systemVerilogSource

  verilator-waivers:
    files:
    - waivers/BPE.vlt
    file_type: vlt

targets:
  default: &default
    filesets:
    - rtl
    - tool_verilator ? (verilator-waivers)