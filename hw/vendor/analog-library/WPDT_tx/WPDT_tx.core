name: epfl:cheep:wpdt_tx:0.1.0
description: WPDT model

filesets:
  rtl:
    depend:
    - epfl:cheep:analog_defs
    files:
    - Verilog/WPDT_tx.sv
    file_type: systemVerilogSource

  verilator-waivers:
    files:
    file_type: vlt

targets:
  default: &default
    filesets:
    - rtl
    - tool_verilator ? (verilator-waivers)